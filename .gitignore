# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# generated shared secret for pipeline-service auth (see start.sh) — must
# never be committed, one is generated per-deployment on first run
.pipeline-secret

# lock file for start-services.sh's flock guard against overlapping runs
.start-services.lock

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Pipeline job data + SQLite database (runtime-generated, not source)
/data/
/db/
/download/
/upload/
/tool-results/

# Build artifacts
/mini-services-dist/
upload/
pipeline/models/
pipeline/piper/
pipeline/voices/
pipeline/models/
data/cache/

# Runtime artifacts
.zscripts/dev.pid
pipeline/__pycache__/

# Python virtual environment (created by setup.sh)
.venv/

# Log directory (created by setup.sh tmux fallback)
logs/
*.pyc
yolov8n.pt
