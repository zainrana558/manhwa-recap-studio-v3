# ═══════════════════════════════════════════════════════════════════════════
#  Manhwa Recap Studio v3 — Environment Configuration (TEMPLATE)
# ═══════════════════════════════════════════════════════════════════════════
#
#  setup.sh copies this to .env and rewrites every "/path/to/your/project"
#  below to the real checkout path automatically. Copy it by hand only if
#  you want to review/override first:
#
#      cp .env.example .env      # then replace /path/to/your/project
#
#  Everything under "OPTIONAL" is safe to leave commented out — the pipeline
#  runs fully local with $0 of API spend using RapidOCR + edge-tts + Piper.
#
#  .env is gitignored and MUST NOT be committed — it holds secrets.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
# Local single-box deploy: a SQLite file (setup.sh writes the real path).
DATABASE_URL=file:/path/to/your/project/db/custom.db
# Hosted split-deploy (Vercel + Turso) only — leave the line above, unset these:
# DATABASE_URL=libsql://manhwa-recap-<you>.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...

# ── Paths (Python venv + project layout) ──────────────────────────────────
PYTHON_BIN=/path/to/your/project/.venv/bin/python3
PROJECT_ROOT=/path/to/your/project
DATA_DIR=/path/to/your/project/data
# Prepended so shutil.which("piper") resolves when master_pipeline.py is
# spawned from systemd (systemd's EnvironmentFile does NOT shell-expand $PATH).
PATH=/path/to/your/project/pipeline/piper/piper:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── Inter-service wiring ──────────────────────────────────────────────────
# Shared secret for pipeline-service /internal/* + socket.io auth. start.sh
# generates one into .pipeline-secret if left blank; both must match.
# NEXT_PUBLIC_* is the SAME value, baked into the browser bundle at build
# time — the live-progress socket is refused without it.
PIPELINE_SECRET=
NEXT_PUBLIC_PIPELINE_SECRET=
# Where the Next.js API reaches pipeline-service (server-side). Local box:
PIPELINE_SERVICE_URL=http://localhost:3001
# Leave NEXT_PUBLIC_PIPELINE_SERVICE_URL UNSET on a single box — the browser
# then routes the socket through Caddy (?XTransformPort=3001). Only set it
# for a split deploy where the browser hits pipeline-service on its own URL.
# NEXT_PUBLIC_PIPELINE_SERVICE_URL=
# Where pipeline-service reaches the OCR mini-service (default is fine):
OCR_SERVICE_URL=http://localhost:3002

# ── Local LLMs via Ollama (OPTIONAL — free, no key) ───────────────────────
# Only used for VLM panel transcription when NO cloud VLM key is set, and
# for narration rewriting when --narration-provider ollama. The production
# recap flow (per-frame RapidOCR + --narration-provider none) does not need
# these. On a small ARM box run setup.sh with SKIP_OLLAMA=1 and set a free
# GEMINI_API_KEY below instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TEXT_MODEL=llama3.2:3b

# ── TTS (Piper primary, edge-tts, eSpeak fallback) ───────────────────────
PIPER_VOICE_MODEL=/path/to/your/project/pipeline/voices/en_US-ryan-high.onnx
# OPTIONAL neural TTS — Kokoro-82M ONNX (local, no key, Apache-2.0). Runs in
# its own venv (numpy>=2, isolated from the main venv). One-time setup:
#     bash pipeline/setup_kokoro.sh
# Then set the engine; edge-tts stays the automatic fallback if it ever fails.
# On this 4-vCPU box: ~4x real-time, no network round-trip / no MS throttling.
# RECAP_TTS_ENGINE=kokoro
# RECAP_KOKORO_VOICE=af_heart      # 54 voices — af_*/am_* (US), bf_*/bm_* (UK), ...
# RECAP_KOKORO_SPEED=1.0
# RECAP_KOKORO_PYTHON=             # override the .venv-kokoro python if elsewhere
# Parallel edge-tts pre-synthesis workers. ~2 per real CPU core:
# 4 on a 2-core box, 2 on a 1-OCPU ARM free instance.
RECAP_TTS_WORKERS=2
# edge-tts throttle-wave breaker (Microsoft datacenter-IP rate limiting):
# after N consecutive failures, skip edge-tts for M seconds and use Piper.
RECAP_EDGE_TTS_WAVE_THRESHOLD=6
RECAP_EDGE_TTS_WAVE_COOLDOWN=150

# ── Pipeline rendering knobs (OPTIONAL — sane defaults in master_pipeline.py) ──
# RECAP_FPS=12
# RECAP_FRAME_MODE=page            # page | panel
# RECAP_OCR_FRAMES=1               # 0 disables per-frame OCR transcription
# RECAP_TEXT_DET_SPLIT=1           # 0 disables the RT-DETR caption splitter
# RECAP_SEAM_STITCH=1
# RECAP_PANEL_FIT_MARGIN=0.9
# RECAP_WATERMARK=Your Channel     # or pass --watermark on the CLI

# ── Cloud VLM providers (OPTIONAL — faster/better panel transcription) ────
# Any ONE of these lets pipeline-service transcribe panels without Ollama.
# GEMINI_API_KEY=          # free — aistudio.google.com/apikey  (recommended on ARM)
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=            # free — console.groq.com/keys
# GROQ_VLM_MODEL=
# OPENROUTER_API_KEY=      # free tier — openrouter.ai/keys
# OPENROUTER_VLM_MODEL=
# OPENAI_API_KEY=          # paid — platform.openai.com/api-keys
# SILICONFLOW_API_KEY=
# ZHIPU_API_KEY=
#
# LOCAL, key-free panel captioner — SmolVLM2-500M (Apache-2.0). Pass
# --visual-provider smolvlm (or set RECAP_VISUAL_LOCAL=1 to make it the
# 'auto' fallback when no cloud key is present). ~3.5s/panel on this CPU box;
# runs in the pipeline venv (needs num2words — see pipeline/requirements.txt).
# RECAP_VISUAL_LOCAL=0
# RECAP_SMOLVLM_MODEL=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
# RECAP_SMOLVLM_EDGE=512           # processor longest_edge; 2048 default = 8x slower
# RECAP_SMOLVLM_TOKENS=48

# ── Narration/translation LLM cascade (recap & cleanup styles) ───────────
# rephrase_text / translate_text now walk a provider chain so one provider's
# daily free-tier quota running out on a big job rolls to the next instead of
# silently dropping the whole recap to raw-verbatim mode:
#     openai(paid) -> groq -> gemini flash-lite(free) -> openrouter free -> ollama(local)
# Just set the keys above; nothing else needed. Model overrides:
# RECAP_GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
# RECAP_OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# (Cerebras is intentionally not in the chain — it ended its no-card free tier Aug 2026.)

# ── OCR VLM fallback tier (OPTIONAL — reads stylised SFX / warped text) ───
# The OCR service (mini-services/paddleocr-service) has a last-resort tier
# that sends ONLY the panels its classical engines (RapidOCR -> PaddleOCR ->
# Tesseract) could not read to a multimodal model. It re-uses GEMINI_API_KEY
# / OPENROUTER_API_KEY above — with no key it is a no-op. start.sh now sources
# this file so the key reaches the (pure-Python) OCR service too.
# OCR_VLM_PROVIDER=auto            # auto | gemini | openrouter | none
# OCR_VLM_MODEL=                   # override (default: gemini-2.0-flash)
# OCR_VLM_MAX_CALLS_PER_MIN=12     # sliding-window cap to stay in the free tier
# OCR_VLM_ON_ZERO_REGIONS=0        # 1 = also try the VLM on panels the detector
#                                  #     called blank (catches bubble-less SFX;
#                                  #     costs a call on every silent panel)
#
# LOCAL, KEY-FREE VLM OCR tier — GOT-OCR2.0 (580M, Apache-2.0). Same trigger
# as the cloud tier (a text region was found but no classical engine read it
# confidently), tried BEFORE the cloud VLM. ~10s/panel on this CPU box, so
# it's off by default and hard-capped per process. Verbatim-accurate on
# stylised bold lettering RapidOCR mangles ("HE'S BEHIND US!!!" etc.).
# Runs in the shared project venv (transformers/torch already present);
# first use downloads ~1.4GB to the HF cache.
# OCR_LOCAL_VLM=0                   # 1 / got-ocr2 to enable
# OCR_LOCAL_VLM_MODEL=stepfun-ai/GOT-OCR-2.0-hf
# OCR_LOCAL_VLM_MAX_CALLS=120       # per-process cap (0 = unlimited)
#
# RapidOCR PP-OCRv5 detection tuning (2026-09-09: defaults changed 1.8/0.4 ->
# 1.6/0.5 — the old pair over-dilated boxes on the reconstruction-path crops,
# turning "US!!!" into "iiisn" and dropping clauses. New = RapidOCR's own
# defaults. These env vars A/B them without a redeploy):
# RECAP_OCR_UNCLIP=1.6             # box dilation; lower = tighter, less line-merge
# RECAP_OCR_BOX_THRESH=0.5         # min box score to keep

# ── Cloudflare R2 video storage (OPTIONAL — hosted split-deploy only) ─────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=manhwa-recaps
# R2_PUBLIC_URL=

# ── Misc ─────────────────────────────────────────────────────────────────
# KEEP_JOB_ARTIFACTS=1     # keep data/jobs/<id>/ after a successful job (debug)
# PRODUCTION_PIPELINE=1    # set by --production-mode; enables state.sqlite + QA gates
