# Manhwa Recap Studio v3 — Production Caddy Config
# Change :80 to your domain (e.g. recap.example.com) for auto-HTTPS

:80 {
        @pipeline {
                path /socket.io/*
        }
        handle @pipeline {
                reverse_proxy localhost:3001
        }

        @internal_api {
                path /internal/*
        }
        handle @internal_api {
                reverse_proxy localhost:3001
        }

        @slicer {
                path /slicer /slicer/*
        }
        handle @slicer {
                reverse_proxy localhost:8899
        }

        handle {
                reverse_proxy localhost:3000
        }
}
